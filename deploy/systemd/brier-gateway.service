[Unit]
Description=Brier gateway (matching engine, journal, REST and WebSocket API)
After=network-online.target postgresql.service postgresql@16-main.service
Wants=network-online.target postgresql@16-main.service
Requires=postgresql.service
# The gateway exits when it loses the database and is restarted until Postgres is back, so
# never give up restarting.
StartLimitIntervalSec=0

[Service]
User=brier
Group=brier
EnvironmentFile=/etc/brier/gateway.env
ExecStart=/opt/brier/bin/brier-gateway serve
Restart=always
RestartSec=3
# SIGTERM lets the gateway finish its batch; the journal is durable before any acknowledgement.
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/brier
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
