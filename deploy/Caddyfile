# The public entrance (brier-web): HTTPS from Let's Encrypt, the WebSocket and the public REST
# API to the gateway on the private network, everything else to the web app.
{$BRIER_HOST} {
	encode zstd gzip
	@api path /v1/*
	handle @api {
		reverse_proxy {$BRIER_GATEWAY} {
			header_up X-Brier-Proxy-Key {$BRIER_PROXY_KEY}
			header_up X-Brier-Client-Address {remote_host}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
	# On every response, the API's included; the web app adds its per-request CSP itself.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-Via
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# Former addresses forward to the current one, path and query kept. install-web.sh writes one
# file here per deploy from BRIER_OLD_HOSTS; with none set the folder is empty.
import /etc/caddy/brier-redirects/*.caddy
